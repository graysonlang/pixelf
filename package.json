{
  "name": "@graysonlang/repo-template",
  "version": "0.1.0",
  "private": true,
  "description": "Project template for @graysonlang/esp, with VS Code build and debug configuration, TypeScript validation, and a test harness",
  "keywords": [],
  "homepage": "https://github.com/graysonlang/repo-template#readme",
  "bugs": {
    "url": "https://github.com/graysonlang/repo-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graysonlang/repo-template.git"
  },
  "license": "MIT",
  "author": "Grayson Lang",
  "type": "module",
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "ports": "node ./scripts/build.mjs --print-port",
    "sync:launch": "node ./scripts/build.mjs --sync-launch",
    "build": "node ./scripts/build.mjs --lint --minify",
    "serve": "node ./scripts/build.mjs --lint --sourcemap --watch --serve --debug-port=auto",
    "serve:https": "ESP_DEV_CERT_NAME=$npm_package_config_esp_dev_cert_name npm run serve -- --host=0.0.0.0",
    "dev": "npm run serve -- --proxy --launch",
    "dev:https": "npm run serve:https -- --proxy --launch",
    "vscode:build": "npm run build -- --vscode",
    "vscode:debug": "npm run serve -- --vscode",
    "vscode:debug:https": "npm run serve:https -- --vscode",
    "cert:dev": "ESP_DEV_CERT_NAME=$npm_package_config_esp_dev_cert_name esp-generate-dev-cert",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "config": {
    "esp_dev_cert_name": "graysonlang-esp-dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@graysonlang/esp": "^2.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  }
}
